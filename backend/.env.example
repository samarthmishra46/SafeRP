# Required: Mapbox token with Directions + Geocoding scopes (server-side only).
MAPBOX_ACCESS_TOKEN=pk.your-token

# Django
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.vercel.app

# Comma-separated frontend origins allowed to call the API.
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Optional regexes, e.g. for Vercel preview deployments.
CORS_ALLOWED_ORIGIN_REGEXES=

# Optional: shared cache. Local memory cache is used when unset.
REDIS_URL=

# Optional tuning (defaults shown)
WIND_METRIC=gust
TRUCK_SPEED_FACTOR=1.0
FORECAST_HORIZON_HOURS=168
MAX_WEATHER_POINTS=500
HEATMAP_MAX_POINTS=400
THROTTLE_PLAN=12/min
THROTTLE_HEATMAP=12/min
THROTTLE_GEOCODE=120/min

# Set to true if upstream calls stall ~15 s on a network with broken IPv6 DNS.
HTTP_FORCE_IPV4=false
